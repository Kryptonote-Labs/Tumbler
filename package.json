{
  "name": "tumbler-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "compatibility:fixtures": "bun scripts/generate-spreadsheet-compatibility-fixtures.ts",
    "compatibility:openxml": "bash scripts/validate-openxml.sh",
    "references:fetch": "bash scripts/fetch-reference-sources.sh",
    "test": "bun test --pass-with-no-tests"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
