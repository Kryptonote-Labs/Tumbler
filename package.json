{
  "name": "tumbler-js",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "compatibility:fixtures": "bun scripts/generate-spreadsheet-compatibility-fixtures.ts",
    "compatibility:libreoffice": "bash scripts/roundtrip-libreoffice.sh",
    "compatibility:openxml": "bash scripts/validate-openxml.sh",
    "references:fetch": "bash scripts/fetch-reference-sources.sh",
    "release:verify": "bun scripts/verify-release.ts",
    "release:qualify": "bash scripts/qualify-release.sh",
    "release:next": "bun scripts/publish-next.ts",
    "release:publish": "bun scripts/publish-next.ts --confirm",
    "test": "bun test --pass-with-no-tests",
    "dev": "bun run --cwd apps/docs dev",
    "docs:check": "bun run --cwd apps/docs check",
    "docs:build": "bun run --cwd apps/docs build",
    "docs:test": "bun run --cwd apps/docs test:e2e",
    "compatibility:presentations": "bun scripts/generate-presentation-fixtures.ts",
    "compatibility:presentation-rendering": "bun scripts/generate-presentation-conformance.ts",
    "compatibility:word": "bun tools/word-compatibility/cli.ts",
    "compatibility:word:check": "tsc --noEmit -p tools/word-compatibility/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.9.0",
    "pptxgenjs": "^4.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
